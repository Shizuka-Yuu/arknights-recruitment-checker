          {(showAllCombos ? allCombos : allCombos.slice(0, 5)).map((result, index) => {
            // ç¬˜ãE~2é«±æ«E½¡E¨é‰ï½ºè •å¾ŒâEç¹§E­ç¹ï½£ç¹ï½©ç¹§E¯ç¹§E¿ç¹ï½¼ç¸ºãƒ»è‰ï½¶ç¸ºE«ç¸ºEªç¹§å¥E½E´èœ·åŒ»ãƒ»é«±æ«E½¡E¨é‰ï½º
            const filteredCharacters = result.characters
