                        <span className="font-medium" style={{ display: 'block' }}>
                          {language === 'ja' ? '9è­ã‚‹ä¿£éšªE­è³å£¹â€²è ¢ãƒ»E½åŸŸæ“…è‰ï½¶ç¸ºE§ç¸ºãƒ» : '9-hour setting is required'}
                        </span>
                      </span>
                    )}
                    {!result.combo.includes('è³é¡”ï½´å£¹ãŠç¹ï½ªç¹ï½¼ç¹ãE) && result.characters.some(char => char.tags.includes('ç¹ï½­ç¹æ‡Šãƒ£ç¹ãE)) && (
                      <div className="flex flex-col items-start" style={{ display: 'block', width: '100%' }}>
                        <div className="flex items-center text-xs" style={{ color: 'var(--text-secondary)', display: 'block' }}>
                          <span>{language === 'ja' ? 'ç¹ï½­ç¹æ‡Šãƒ£ç¹è‚²æ¼ç¸ºãƒ» 3è­ã‚‹ä¿£50è›»ãƒ»â†“éšªE­è³å£¹E ç¸ºE¦ç¸ºä¸Šâ–¡ç¸ºè¼”ï¼E : 'Robot target: set to 3h50m'}</span>
                        </div>
                        <div className="text-xs mt-1" style={{ color: '#f59e0b' }}>
                          {language === 'ja' ? 'çª¶E»éï½­è­ã‚‹ä¿£éšªE­è³å£¹ãƒ»ç¹§E¿ç¹§E°è±¸äº¥E¤E±ç¹ï½ªç¹§E¹ç¹§E¯' : 'çª¶E»Short time has tag loss risk'}
                        </div>
                      </div>
                    )}
                    {!result.combo.includes('è³é¡”ï½´å£¹ãŠç¹ï½ªç¹ï½¼ç¹ãE) && !result.characters.some(char => char.tags.includes('ç¹ï½­ç¹æ‡Šãƒ£ç¹ãE)) && (
                      <span style={{ color: '#f59e0b', display: 'block', width: '100%' }}>
                        <span style={{ display: 'block' }}>
                          {language === 'ja' ? '9è­ã‚‹ä¿£éšªE­è³å£½è€³è‚ï½¨ãƒ»è‚²E¨Â€ç¸ºE«ç¹§E¿ç¹§E°è±¸äº¥E¤E±ç¹ï½ªç¹§E¹ç¹§E¯ãƒ»ãƒ» : '9-hour setting recommended (rare tag loss risk)'}
                        </span>
                      </span>
                    )}
                  </div>
                  <div className="flex items-center gap-1" style={{ minWidth: '80px', justifyContent: 'flex-end' }}>
                    <div className="w-2 h-2 rounded-full" style={{ backgroundColor: '#16a34a' }}></div>
                    <span className="text-xs" style={{ color: '#16a34a' }}>
                      {language === 'ja' ? 'é’ï½ºè³ãƒ» : 'Guaranteed'}
                    </span>
                  </div>
                </div>
              </div>
            )
          })}
          </div>
        </div>
      )}

      {/* é¨¾å£¼E¸E¸ç¸ºE®é‚¨ãƒ»âˆ©èœ·åŒ»Eç¸ºå¸·Eµå…ˆæ£¡ - ç¹§E­ç¹ï½£ç¹ï½©ç¹§E¯ç¹§E¿ç¹ï½¼è¬¨E°è­ãEE½ãƒ»ã€’é™¦E¨é‰ï½º */}
